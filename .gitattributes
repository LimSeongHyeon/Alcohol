# Normalize line endings so a Windows checkout doesn't churn the diff
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

# Treat these as binary regardless of content sniffing
*.png   binary
*.jpg   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary

# Keep the license text byte-identical to upstream
LICENSE -text
